[Unit]
Description=Mirror the Burgas municipality news RSS into the bg-coast-news bucket
Documentation=https://github.com/nazmang/docker/blob/master/debian01/README.md#burgas-news-feed-mirror
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/burgas-feed.sh
# The S3 key (PutObject only): root:root 600 on disk, handed to the run as
# $CREDENTIALS_DIRECTORY/credentials, readable only by this unit's dynamic user.
LoadCredential=credentials:/etc/burgas-feed/credentials
DynamicUser=yes
# fetch 30 s + upload 60 s, with room to spare; a hung run must not overlap the next tick
TimeoutStartSec=120
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
# AF_UNIX: name resolution through nss-resolve/varlink needs it
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Prometheus textfile metric, written as root ("+") and only after a successful run:
# the dynamic user cannot write there, and a failed run must leave the old timestamp
# so an alert on its age fires. Skipped quietly when node_exporter is not installed.
ExecStartPost=+/usr/local/bin/burgas-feed.sh --write-metric
