      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "costs-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT c.day AS time, coalesce(p.name, c.project) || ' · ' || regexp_replace(c.item, ',\\s*.*$', '') AS metric, sum(c.usd) AS value\nFROM costs_daily c LEFT JOIN openai_projects p ON p.id = c.project\nWHERE c.service='openai' AND c.project IN (${oai_project:sqlstring}) AND $__timeFilter(c.day)\nGROUP BY 1, 2 HAVING sum(c.usd) > 0 ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
