      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "costs-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(p.name, c.project) AS \"Проект\", regexp_replace(c.item, ',\\s*.*$', '') AS \"Модель\", round(sum(c.usd), 4) AS \"$\"\nFROM costs_daily c LEFT JOIN openai_projects p ON p.id = c.project\nWHERE c.service='openai' AND c.project IN (${oai_project:sqlstring}) AND c.day >= date_trunc('month', (now() AT TIME ZONE 'UTC')::date)::date\nGROUP BY 1, 2 HAVING sum(c.usd) > 0 ORDER BY 3 DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          }
