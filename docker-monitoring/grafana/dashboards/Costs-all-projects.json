          "rawQuery": true,
          "rawSql": "WITH m AS (SELECT sum(c.usd) s, count(distinct c.day) d FROM costs_daily c LEFT JOIN projects p ON p.service = c.service AND p.id = c.project WHERE c.service <> 'elevenlabs' AND c.service IN (${provider:sqlstring}) AND ('__all' IN (${project:sqlstring}) OR c.service || ':' || c.project IN (${project:sqlstring})) AND c.day >= date_trunc('month', (now() AT TIME ZONE 'UTC')::date)::date)\nSELECT CASE WHEN d >= 5 THEN s * extract(day from (date_trunc('month', now()) + interval '1 month - 1 day')) / d END AS value FROM m",
