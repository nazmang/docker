        "type": "grafana-postgresql-datasource",
        "uid": "costs-postgres"
      },
      "description": "Месяц-к-дате, экстраполированный на весь месяц. Пусто до 5-го числа.",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 10
      },
      "id": 5,
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "costs-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH m AS (SELECT sum(c.usd) s, count(distinct c.day) d FROM costs_daily c WHERE c.service='openai' AND c.project IN (${oai_project:sqlstring}) AND c.day >= date_trunc('month', (now() AT TIME ZONE 'UTC')::date)::date)\nSELECT CASE WHEN d >= 5 THEN s * extract(day from (date_trunc('month', now()) + interval '1 month - 1 day')) / d END AS value FROM m",
          "refId": "A"
        }
      ],
      "title": "Темп, $/мес",
