          "rawQuery": true,
          "rawSql": "SELECT sum(c.usd) AS value FROM costs_daily c WHERE c.service='openai' AND c.project IN (${oai_project:sqlstring}) AND c.day >= date_trunc('month', (now() AT TIME ZONE 'UTC')::date)::date",
          "refId": "A"
