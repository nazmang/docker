@Library('jenkins-telegram-notify') _

def deployExecuted = false

pipeline {

    agent { label 'cloud && hetzner' } // Ensure the agent has Docker and Swarm mode enabled

    parameters {
        booleanParam(name: 'FORCE_REDEPLOY', defaultValue: false, description: 'Force redeployment of stack even if no changes detected')
    }

    environment {
        // Define environment variables for the stack
        DOCKER_STACK_NAME = 'monitoring'
        DOCKER_COMPOSE_DIR = 'docker-monitoring' // Path to docker-compose.yml
        DOCKER_COMPOSE_FILE = 'docker-compose.yml' // Name of your main Docker Compose file
        // Grafana params
        GF_SECURITY_ADMIN_USER = "${params.GF_ADMIN_USER}" // Default admin user for Grafana
        GF_SECURITY_ADMIN_PASSWORD = "${params.GF_ADMIN_PASSWORD}" // Default admin password for Grafana    
        // Image tags 
        // 13.2.1 с 11.09.2026. Здесь стояло 10.3.5, хотя обновление уже было
        // выкачено -- то есть первый же деплой стека молча откатил бы Grafana
        // на старую версию, и никто бы не связал это с пайплайном.
        //
        // Обновление тогда делалось командой docker service update, мимо
        // пайплайна. Так и появляется расхождение: работает одно, в репозитории
        // написано другое, и репозиторий выигрывает при следующем деплое.
        // Версии образов задаются здесь и только здесь.
        GRAFANA_TAG="13.2.1"
        PROM_TAG="v2.53.4"
        ALERTMGR_TAG="v0.26.0"
        NTFY_AM_TAG="1.0.1"
        KARMA_TAG="v0.121"
        // Prometheus config and rules ship as Swarm configs, and Swarm configs
        // are immutable -- their names must change for new content to reach the
        // service. The commit sha does that automatically, so a config change
        // deploys exactly like a code change and cannot be half-applied.
        // Telegram configre
        TELEGRAM_BOT_TOKEN = credentials('telegramToken')
        TELEGRAM_CHAT_ID = credentials('telegramChatid')  
        // Slack params
        // SLACK_URL = 'https://hooks.slack.com/services/TOKEN' // Slack webhook URL for Alertmanager
        // SLACK_CHANNEL = 'general' // Slack channel for alerts
        // SLACK_USER = 'alertmanager' // Slack username for alerts
    }

    stages {

        stage('Create Files') {
             when {
                anyOf {
                    changeset "**/${env.DOCKER_COMPOSE_DIR}/**"
                    expression { params.FORCE_REDEPLOY }
                }
             }
            steps {
                script {
                    def composeDir = "${env.WORKSPACE}/${env.DOCKER_COMPOSE_DIR}"
                    // Asked git rather than env.GIT_COMMIT: on the first run
                    // that variable was empty and every config object landed as
                    // *_manual, which defeats the versioning entirely -- the
                    // name would stop changing and new content would stop
                    // reaching the service.
                    def configVersion = sh(
                        script: 'git rev-parse --short=8 HEAD',
                        returnStdout: true
                    ).trim()
                    def envContent = """
                    GF_SECURITY_ADMIN_USER=${env.GF_SECURITY_ADMIN_USER}
                    GF_SECURITY_ADMIN_PASSWORD=${env.GF_SECURITY_ADMIN_PASSWORD}
                    # SLACK_URL=${env.SLACK_URL}
                    # SLACK_CHANNEL=${env.SLACK_CHANNEL}
                    # SLACK_USER=${env.SLACK_USER}
                    GRAFANA_TAG=${env.GRAFANA_TAG}
                    PROM_TAG=${env.PROM_TAG}
                    ALERTMGR_TAG=${env.ALERTMGR_TAG}
                    NTFY_AM_TAG=${env.NTFY_AM_TAG}
                    KARMA_TAG=${env.KARMA_TAG}
                    PROM_CONFIG_VERSION=${configVersion}
                    """
                    // echo "Generated .env content:\n${envContent}"
                    // stripIndent(), потому что треугольные кавычки Groovy
                    // сохраняют отступы, а .env с отступами ломается при
                    // разборе -- см. комментарий в Makefile о том, как из-за
                    // этого пропадал PROM_CONFIG_VERSION.
                    writeFile file: "${composeDir}/.env", text: envContent.stripIndent()
                }
            }
        }

        stage('Deploy Monitoring Stack') {
             when {
                anyOf {
                    changeset "**/${env.DOCKER_COMPOSE_DIR}/**"
                    expression { params.FORCE_REDEPLOY }
                }
             }
            steps {                
                script {
                    dir("${env.DOCKER_COMPOSE_DIR}"){
                        // Deploy the stack using docker stack deploy
                        sh "make -f Makefile -e deploy-all STACK_NAME=${env.DOCKER_STACK_NAME}"                    
                    }
                    deployExecuted = true
                }
            }
        }
    }

    post {
        success {
            script {
                if (deployExecuted) {
                    def message = "✅ <b>Monitoring Deploy Success</b>\n" +
                                  "Job: ${env.JOB_NAME}\n" +
                                  "Build: #${env.BUILD_NUMBER}\n" +
                                  "Stack: ${env.DOCKER_STACK_NAME}\n" +
                                  "URL: <a href=\"${env.BUILD_URL}\">Link</a>"
                    telegram.sendMessage(env.TELEGRAM_BOT_TOKEN, env.TELEGRAM_CHAT_ID, message, 'HTML')
                } else {
                    echo "Deploy stack was not executed, skipping Telegram notification."
                }
            }
        }
        failure {
            script {
                def message = "❌ <b>Monitoring Deploy Failed</b>\n" +
                          "Job: ${env.JOB_NAME}\n" +
                          "Build: #${env.BUILD_NUMBER}\n" +
                          "Stack: ${env.DOCKER_STACK_NAME}\n" +
                          "URL: <a href=\"${env.BUILD_URL}\">Link</a>"
                telegram.sendMessage(env.TELEGRAM_BOT_TOKEN, env.TELEGRAM_CHAT_ID, message, 'HTML')
            }
        }
        always {
            cleanWs()
        }
    }
}